rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /works/{workId} {
      allow read: if request.auth != null &&
        (resource.data.uid == request.auth.uid || resource.data.isPublicRec == true);
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.uid == request.auth.uid;
    }

    match /bookcases/{bookcaseId} {
      allow read: if request.auth != null &&
        (resource.data.uid == request.auth.uid || resource.data.isPublic == true);
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.uid == request.auth.uid;
    }

    match /communityRecs/{recId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.uid;
    }

    match /notifications/{notifId} {
      allow read: if request.auth != null &&
        resource.data.uid == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.uid == request.auth.uid;
    }

    match /settings/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ⚠️ UID de admin hardcoded abaixo (7 ocorrências neste arquivo).
    // Espelha ADMIN_UIDS em src/lib/fanfarra/config.ts — se trocar de conta
    // admin, atualize os DOIS lugares e reimplante as regras no Firebase.

    match /challenges_catalog/{challengeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid in ["ikvASYa9kgQknCrZeiiupirGGef1"];
    }

    match /user_challenges/{docId} {
      allow read: if request.auth != null &&
        resource.data.uid == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.uid == request.auth.uid;
    }

    // ── Fanfarra Awards ──────────────────────────────────────────────
    match /awards_config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid in ["ikvASYa9kgQknCrZeiiupirGGef1"];
    }

    match /awards_catalog/{categoryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid in ["ikvASYa9kgQknCrZeiiupirGGef1"];
    }

    match /award_votes_indicacao/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null &&
    (request.auth.uid == uid || request.auth.uid == "ikvASYa9kgQknCrZeiiupirGGef1");
    }

   	match /award_votes_final/{uid} {
  		allow read: if request.auth != null;
  		allow create, update, delete: if request.auth != null &&
    (request.auth.uid == uid || request.auth.uid == "ikvASYa9kgQknCrZeiiupirGGef1");
		}

    // ── Sistema antigo de sugestão manual (mantido só pra não quebrar a limpeza de conta) ──
    match /award_nominations/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.uid ||
         request.auth.uid in ["ikvASYa9kgQknCrZeiiupirGGef1"]);
    }

   match /award_reactions/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.uid;
    }

    // ── Aplaudir/vaiar nas recomendações reais ──────────────────────
    match /rec_reactions/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.uid;
    }
    
    match /rec_comments/{id} {
  allow read: if request.auth != null;
  allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
  allow delete: if request.auth != null &&
    (request.auth.uid == resource.data.uid || request.auth.uid == "ikvASYa9kgQknCrZeiiupirGGef1");
}

    match /rec_reaction_counts/{itemId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /rec_reaction_daily_snapshot/{day} {
      allow read: if request.auth != null;
      allow write: if false; // só o GitHub Actions (Admin SDK) escreve aqui
    }

  }
}