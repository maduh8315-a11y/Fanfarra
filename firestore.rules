rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin ────────────────────────────────────────────────────────
   // Único lugar nas regras onde o admin é resolvido. Lê o MESMO
    // documento que o client usa (app_config/admins) — não há mais UID
    // hardcoded aqui, então não há nada para sincronizar manualmente.
    function isAdmin() {
    return request.auth != null &&
    request.auth.uid in get(/databases/$(database)/documents/app_config/admins).data.uids;
    }

    function existsBlockBetween(a, b) {
      return exists(/databases/$(database)/documents/blocks/$(a + '_' + b)) ||
             exists(/databases/$(database)/documents/blocks/$(b + '_' + a));
    }

    match /app_config/admins {
      allow read: if request.auth != null;
      allow write: if false; // só editável pelo Console / Admin SDK — nunca pelo client
    }

    match /works/{workId} {
      allow read: if request.auth != null &&
        (resource.data.uid == request.auth.uid || resource.data.isPublicRec == true);
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.uid == request.auth.uid;
    }

    match /bookcases/{bookcaseId} {
      allow read: if request.auth != null &&
        (resource.data.uid == request.auth.uid || resource.data.isPublic == true);
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.uid == request.auth.uid;
    }

    match /communityRecs/{recId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.uid;
    }

    match /notifications/{notifId} {
      allow read: if request.auth != null &&
        resource.data.uid == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.uid == request.auth.uid;
    }

    match /push_tokens/{tokenId} {
      // só o cron (Admin SDK) lê — ele ignora as rules de qualquer forma
      allow read: if false;
      allow create, update: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null &&
        resource.data.uid == request.auth.uid;
    }

    match /settings/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.pro == false;

      // Ninguém consegue mudar `pro` pelo client, exceto o admin (o toggle
      // [DEV] em /settings, que já só aparece pra admin). Pra qualquer
      // outro usuário, esse campo só muda via webhook do servidor
      // (googleFirestoreRest.server.ts, que usa service account e não
      // passa por essas regras).
      allow update: if request.auth != null && request.auth.uid == uid
        && (request.resource.data.pro == resource.data.pro || isAdmin());
    }

    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /challenges_catalog/{challengeId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /user_challenges/{docId} {
      allow read: if request.auth != null &&
        resource.data.uid == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.uid == request.auth.uid;
    }

    // ── Fanfarra Awards ──────────────────────────────────────────────
    match /awards_config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /awards_catalog/{categoryId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /awards_history/{docId} {
  allow read: if request.auth != null;
  allow write: if isAdmin();
}

    match /award_votes_indicacao/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
    }

    match /award_votes_final/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
    }

    // ── Sistema antigo de sugestão manual (mantido só pra não quebrar a limpeza de conta) ──
    match /award_nominations/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;

      // "update" fica aberto pra qualquer autenticado porque quem
      // incrementa applause/boos é QUEM REAGE, não o dono da indicação.
      // Travado: só pode alterar applause/boos, em no máximo ±1 por vez,
      // e nada mais (nem workTitle, nem uid, nem themeId).
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applause', 'boos']) &&
        request.resource.data.applause is int && request.resource.data.applause >= 0 &&
        request.resource.data.boos is int && request.resource.data.boos >= 0 &&
        (request.resource.data.applause - resource.data.applause) in [-1, 0, 1] &&
        (request.resource.data.boos - resource.data.boos) in [-1, 0, 1];

      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
    }

    match /award_reactions/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.uid;
    }

    match /rec_comments/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin());
    }

   // Escrita agora só acontece via reactToRecItemServer (service account,
// que ignora as regras) — o client só lê.
match /rec_reactions/{id} {
  allow read: if request.auth != null;
  allow write: if false;
}

match /rec_reaction_counts/{itemId} {
  allow read: if request.auth != null;
  allow write: if false;
}

    match /rec_reaction_daily_snapshot/{day} {
      allow read: if request.auth != null;
      allow write: if false; // só o GitHub Actions (Admin SDK) escreve aqui
    }

    // ── Amizade / Seguir / Chat ─────────────────────────────────────────
    match /public_profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /friend_requests/{id} {
      allow read: if request.auth != null &&
        (resource == null || resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.fromUid &&
        request.resource.data.fromUid != request.resource.data.toUid &&
        request.resource.data.status == 'pending' &&
        id == request.resource.data.fromUid + '_' + request.resource.data.toUid;

      // só quem RECEBEU o pedido pode responder, e só pode mudar status/updatedAt
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.toUid &&
        resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        request.resource.data.status in ['accepted', 'declined'];

      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
    }

    match /friendships/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;

      // só cria amizade se existir um friend_request ACEITO entre os dois (em qualquer direção)
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.members.size() == 2 &&
        (
          (exists(/databases/$(database)/documents/friend_requests/$(request.resource.data.members[0] + '_' + request.resource.data.members[1])) &&
            get(/databases/$(database)/documents/friend_requests/$(request.resource.data.members[0] + '_' + request.resource.data.members[1])).data.status == 'accepted')
          ||
          (exists(/databases/$(database)/documents/friend_requests/$(request.resource.data.members[1] + '_' + request.resource.data.members[0])) &&
            get(/databases/$(database)/documents/friend_requests/$(request.resource.data.members[1] + '_' + request.resource.data.members[0])).data.status == 'accepted')
        );

      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
    }

    match /blocks/{id} {
      allow read: if request.auth != null &&
        (resource == null || resource.data.blockerUid == request.auth.uid || resource.data.blockedUid == request.auth.uid);
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.blockerUid &&
        request.resource.data.blockerUid != request.resource.data.blockedUid &&
        id == request.resource.data.blockerUid + '_' + request.resource.data.blockedUid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.blockerUid;
    }

    match /reports/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.reporterUid &&
        request.resource.data.targetUid != request.resource.data.reporterUid;
    }

    match /follows/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.followerUid &&
        request.resource.data.followerUid != request.resource.data.followingUid &&
        id == request.resource.data.followerUid + '_' + request.resource.data.followingUid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.followerUid;
    }

   match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create, update: if request.auth != null &&
        request.auth.uid in request.resource.data.members &&
        exists(/databases/$(database)/documents/friendships/$(chatId)) &&
        !existsBlockBetween(request.resource.data.members[0], request.resource.data.members[1]);

      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members &&
          request.resource.data.senderUid == request.auth.uid &&
          !existsBlockBetween(
            get(/databases/$(database)/documents/chats/$(chatId)).data.members[0],
            get(/databases/$(database)/documents/chats/$(chatId)).data.members[1]
          );
      }
    }
  }
}